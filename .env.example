POLYWEATHER_DB_PATH=./data/polyweather.db
POLYWEATHER_LOG_LEVEL=INFO

OPEN_METEO_BASE=https://ensemble-api.open-meteo.com/v1/ensemble
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com

POLYWEATHER_EDGE_THRESHOLD=0.20
POLYWEATHER_MIN_LIQUIDITY=2000
POLYWEATHER_PAPER_BANKROLL=500
POLYWEATHER_KELLY_FRACTION=0.25
POLYWEATHER_MAX_PCT_PER_TRADE=0.03
POLYWEATHER_MAX_PCT_PER_MARKET=0.08
POLYWEATHER_MAX_PCT_PER_CITY_DAY=0.15

POLYWEATHER_LAPLACE_ALPHA=0.1

# Day-5 calibration guards (n=56 settled positions, 27% win rate)
POLYWEATHER_MIN_P_MARKET=0.10
POLYWEATHER_P_MODEL_MIN=0.30
POLYWEATHER_P_MODEL_MAX=0.80
POLYWEATHER_OVERCONFIDENCE_THRESHOLD=0.85
POLYWEATHER_OVERCONFIDENCE_KELLY_MULTIPLIER=0.5

# Realism penalties — make paper PnL track live more closely
POLYWEATHER_SIMULATED_SLIPPAGE_PCT=0.05
POLYWEATHER_SIMULATED_FEE_PCT=0.05

# Background scheduler
POLYWEATHER_SCHEDULER_ENABLED=true
POLYWEATHER_SCHEDULER_SCAN_MINUTES=30
POLYWEATHER_SCHEDULER_SETTLE_MINUTES=30
POLYWEATHER_SCHEDULER_RUN_ON_STARTUP=true
POLYWEATHER_SCHEDULER_AUTO_EXECUTE=true
